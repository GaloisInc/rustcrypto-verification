import "../cryptol-specs/Primitive/Keyless/Hash/SHA2Internal/SHA384.cry" as SHA384;
import "Sha2Verif/Sha512.cry" as Sha512;

// Note: platform-specific path to the mir-json output. You will have to change
// this if not running on Mac.
m <- mir_load_module "target/aarch64-apple-darwin/debug/deps/sha2_verif-3c53f8139e44348c.linked-mir.json";

// Lengths of the sample inputs to digest, from lib.rs. We will verify that
// SHA-2 works correctly both of these lengths.
let hello_len = 11;
let long_message_len = 335;

// Rust types used by functions in the sha2 crate and its dependencies.
let UInt = mir_find_adt m "typenum::uint::UInt";
let UTerm = mir_find_adt m "typenum::uint::UTerm" [];
let B1 = mir_find_adt m "typenum::bit::B1" [];
let B0 = mir_find_adt m "typenum::bit::B0" [];
let U1 = UInt [
    mir_adt UTerm,
    mir_adt B1
];
let U2 = UInt [
    mir_adt U1,
    mir_adt B0
];
let U3 = UInt [
    mir_adt U1,
    mir_adt B1
];
let U4 = UInt [
    mir_adt U2,
    mir_adt B0
];
let U6 = UInt [
    mir_adt U3,
    mir_adt B0
];
let U8 = UInt [
    mir_adt U4,
    mir_adt B0
];
let U12 = UInt [
    mir_adt U6,
    mir_adt B0
];
let U16 = UInt [
    mir_adt U8,
    mir_adt B0
];
let U24 = UInt [
    mir_adt U12,
    mir_adt B0
];
let U32 = UInt [
    mir_adt U16,
    mir_adt B0
];
let U64 = UInt [
    mir_adt U32,
    mir_adt B0
];
let U48 = UInt [
    mir_adt U24,
    mir_adt B0
];
let U128 = UInt [
    mir_adt U64,
    mir_adt B0
];
let GenericArray = mir_find_adt m "generic_array::GenericArray";
let Block = GenericArray [mir_u8, mir_adt U128];
let Eager = mir_find_adt m "block_buffer::Eager" [];
let BlockBuffer = mir_find_adt m "block_buffer::BlockBuffer" [mir_adt U128, mir_adt Eager];
let Sha512VarCore = mir_find_adt m "sha2::core_api::Sha512VarCore" [];
let OidSha384 = mir_find_adt m "sha2::OidSha384" [];
let InvalidOutputSize = mir_find_adt m "digest::InvalidOutputSize" [];
let CtVariableCoreWrapper = mir_find_adt m "digest::core_api::ct_variable::CtVariableCoreWrapper" [mir_adt Sha512VarCore, mir_adt U48, mir_adt OidSha384];
let CoreWrapper = mir_find_adt m "digest::core_api::wrapper::CoreWrapper" [mir_adt CtVariableCoreWrapper];
let Sha384 = CoreWrapper;
let Result_new = mir_find_adt m "core::result::Result" [mir_adt Sha512VarCore, mir_adt InvalidOutputSize];
let PhantomDataEager = mir_find_adt m "core::marker::PhantomData" [mir_adt Eager];
let PhantomDataSha384 = mir_find_adt m "core::marker::PhantomData" [mir_tuple [mir_adt U48, mir_adt OidSha384]];

// Construct a Sha384 Rust value.
//
// state in Rust is the same as h in cryptol-specs.
//
// buffer in Rust is the same as block in cryptol-specs.
//
// pos in Rust is the same as n in cryptol-specs.
//
// block_len in Rust is *not* sz in cryptol-specs. block_len is the number of
// blocks that have been compressed so far, while sz is the total number of
// *bits* that have been processed so far, including the ones just sitting in
// the buffer and not yet compressed. So we have sz = (block_len * 128 + pos) *
// 8.
let sha384_value state buffer pos block_len =
    mir_struct_value CoreWrapper
        [ mir_struct_value CtVariableCoreWrapper
            [ mir_struct_value Sha512VarCore
                [ mir_term state
                , mir_term block_len
                ]
            , mir_struct_value PhantomDataSha384 []
            ]
        , mir_struct_value BlockBuffer
            [ mir_struct_value Block [mir_term buffer]
            , mir_term pos
            , mir_struct_value PhantomDataEager []
            ]
        ];

let sha384_default_spec = do {
    mir_execute_func [];

    let init = {{ SHA384::SHAInit }};
    let res =
        sha384_value
            {{ init.h }}
            {{ init.block }}
            {{ drop (init.n) : [8] }}
            {{ (init.sz / 8 - zext init.n) / 128 }};
    mir_return res;
};

let sha384_default_id = mir_find_name m "digest::core_api::wrapper::{impl#17}::default" [mir_adt CtVariableCoreWrapper];
default_ov <- mir_verify m sha384_default_id [] false sha384_default_spec z3;

let sha384_new_id = mir_find_name m "digest::digest::{impl#0}::new" [mir_adt Sha384];
mir_verify m sha384_new_id [default_ov] false sha384_default_spec z3;

let sigma0_spec = do {
    x <- mir_fresh_var "x" mir_u64;

    mir_execute_func [mir_term x];

    mir_return (mir_term {{ SHA384::s0 x }});
};

sigma0_ov <- mir_verify m "sha2::sha512::soft::sha512_schedule_x2::sigma0" [] false sigma0_spec z3;

let sigma1_spec = do {
    x <- mir_fresh_var "x" mir_u64;

    mir_execute_func [mir_term x];

    mir_return (mir_term {{ SHA384::s1 x }});
};

sigma1_ov <- mir_verify m "sha2::sha512::soft::sha512_schedule_x2::sigma1" [] false sigma1_spec z3;

let sha512_digest_round_spec = do {
    ae <- mir_fresh_var "ae" (mir_array 2 mir_u64);
    bf <- mir_fresh_var "bf" (mir_array 2 mir_u64);
    cg <- mir_fresh_var "cg" (mir_array 2 mir_u64);
    dh <- mir_fresh_var "dh" (mir_array 2 mir_u64);
    wk0 <- mir_fresh_var "wk0" mir_u64;

    mir_execute_func [mir_term ae, mir_term bf, mir_term cg, mir_term dh, mir_term wk0];

    mir_return (mir_term {{ Sha512::sha512_digest_round ae bf cg dh wk0 }});
};

sha512_digest_round_ov <- mir_verify m "sha2::sha512::soft::sha512_digest_round" [] false sha512_digest_round_spec z3;

let sha512_digest_block_u64_spec = do {
    state_arr <- mir_fresh_var "state_arr" (mir_array 8 mir_u64);
    state_ref <- mir_ref_of_mut (mir_term state_arr);
    block_arr <- mir_fresh_var "block_arr" (mir_array 16 mir_u64);
    block_ref <- mir_ref_of (mir_term block_arr);

    mir_execute_func [state_ref, block_ref];

    mir_points_to state_ref (mir_term {{ SHA384::processBlock_Common state_arr block_arr }});
};

let sha512_digest_block_u64_id = "sha2::sha512::soft::sha512_digest_block_u64";
digest_block_u64_ov <- mir_verify m sha512_digest_block_u64_id
    [sigma0_ov, sigma1_ov, sha512_digest_round_ov]
    false sha512_digest_block_u64_spec
    (unint_z3 ["S0", "S1", "s0", "s1", "Ch", "Maj"]);

// All possible values of pos in Rust, aka n in cryptol-specs.
let possible_pos = map eval_int (eval_list {{ [0..<128] : [_][8] }});

let sha384_update_spec (len : Int) (pos : Int) = do {
    state <- mir_fresh_var "state" (mir_array 8 mir_u64);
    buffer <- mir_fresh_var "buffer" (mir_array 128 mir_u8);
    block_len <- mir_fresh_var "block_len" mir_u128;
    // Avoid overflow of sz. Since sz is 128-bit, the maximum block_len we can
    // have is therefore 2^128 / (128 * 8), but we also need to account for
    // increases in block_len during the update itself, which would be (len +
    // pos) / 128.
    mir_precond {{ block_len < 0x00400000000000000000000000000000 - (`len + `pos) / 128 }};
    let self = sha384_value state buffer {{ `pos : [8] }} block_len;
    self_ref <- mir_ref_of_mut self;
    data_arr <- mir_fresh_var "data_arr" (mir_array len mir_u8);
    data_ref <- mir_ref_of (mir_term data_arr);
    let data_slice = mir_slice_value data_ref;

    mir_execute_func [self_ref, data_slice];

    let sinit = {{
        { h = state
        , block = buffer
        , n = (`pos : [32])
        , sz = (block_len * 128 + `pos) * 8
        } : SHA384::SHAState
    }};
    let supdated = {{ SHA384::SHAUpdate sinit data_arr }};
    buffer' <- mir_fresh_var "buffer'" (mir_array 128 mir_u8);
    // cryptol-specs zeros out the buffer after each compression, while the Rust
    // code doesn't. So if there was no compression (pos + len < 128), then the
    // resulting buffers should be exactly the same, while if there was
    // compression, then the buffers would be the same up to the new pos (after
    // which the cryptol-specs version would have zeros and the Rust version
    // would have data from the previous iteration of the buffer).
    mir_postcond
        (if eval_bool {{ `pos + `len < 128 }}
            then {{ buffer' == supdated.block }}
            else {{ take`{(pos + len) % 128} buffer' == take supdated.block }});
    mir_points_to self_ref
        (sha384_value
            {{ supdated.h }}
            {{ buffer' }}
            {{ drop (supdated.n) : [8] }}
            {{ (supdated.sz / 8 - zext supdated.n) / 128 }});
};

let sha384_update_id = mir_find_name m "digest::core_api::wrapper::{impl#7}::update" [mir_adt CtVariableCoreWrapper];
let verify_updates (len : Int) : TopLevel [MIRSpec] = do {
    for possible_pos (\pos -> do {
        print (str_concats ["Verifying update for len = ", show len, ", pos = ", show pos]);
        mir_verify m sha384_update_id [digest_block_u64_ov] false
            (sha384_update_spec len pos)
            (unint_z3 ["processBlock_Common"]);
    });
};
update_hello_ovs <- verify_updates hello_len;
update_long_message_ovs <- verify_updates long_message_len;

let sha384_finalize_spec pos = do {
    state <- mir_fresh_var "state" (mir_array 8 mir_u64);
    buffer <- mir_fresh_var "buffer" (mir_array 128 mir_u8);
    block_len <- mir_fresh_var "block_len" mir_u128;
    // Avoid overflow of sz (and also bit_len in Rust). Since sz and bit_len are
    // 128-bit, the maximum block_len we can have is therefore 2^128 / (128 *
    // 8).
    mir_precond {{ block_len < 0x00400000000000000000000000000000 }};
    let self = sha384_value state buffer {{ `pos : [8] }} block_len;

    mir_execute_func [self];

    // cryptol-specs assumes the block is zeroed out by update, but the Rust
    // version of update doesn't do that, so we need to zero out the part after
    // pos before calling SHAFinal.
    let s = {{
        { h = state
        , block = take`{pos} buffer # zero
        , n = (`pos : [32])
        , sz = (block_len * 128 + `pos) * 8
        } : SHA384::SHAState
    }};
    let output = mir_struct_value (GenericArray [mir_u8, mir_adt U48]) [
        mir_term {{ split (SHA384::SHAFinal s) : [48][8] }}
    ];
    mir_return output;
};

let sha384_finalize_id = mir_find_name m "digest::digest::{impl#0}::finalize" [mir_adt Sha384];
finalize_ovs <-
    for possible_pos (\pos -> do {
        print (str_concat "Verifying finalize for pos = " (show pos));
        mir_verify m sha384_finalize_id [digest_block_u64_ov] false
            (sha384_finalize_spec pos)
            (unint_z3 ["processBlock_Common"]);
    });

let sha384_digest_spec (len : Int) = do {
    data_arr <- mir_fresh_var "data_arr" (mir_array len mir_u8);
    data_ref <- mir_ref_of (mir_term data_arr);

    mir_execute_func [data_ref];

    let output = mir_struct_value (GenericArray [mir_u8, mir_adt U48]) [mir_term {{ split (SHA384::SHAImp data_arr) : [48][8] }}];
    mir_return output;
};

let verify_digest (len : Int) (update_ovs : [MIRSpec]) = do {
    print (str_concat "Verifying digest for len = " (show len));
    let sha384_digest_id = mir_find_name m "digest::digest::{impl#0}::digest" [mir_adt Sha384, mir_ref (mir_array len mir_u8)];
    mir_verify m sha384_digest_id (concat [default_ov] (concat update_ovs finalize_ovs)) false
        (sha384_digest_spec len)
        (unint_z3 ["processBlock_Common"]);
};
verify_digest hello_len update_hello_ovs;
verify_digest long_message_len update_long_message_ovs;
