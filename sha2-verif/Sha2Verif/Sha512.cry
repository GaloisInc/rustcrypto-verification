module Sha2Verif::Sha512 where

import Primitive::Keyless::Hash::SHA2Internal::SHA384 as SHA384

sha512_digest_round : [2][64] -> [2][64] -> [2][64] -> [2][64] -> [64] -> [2][64]
sha512_digest_round [a0, e0] [b0, f0] [c0, g0] [d0, h0] wk0 =
  [x0 + y0, x0 + d0]
  where
  x0 = SHA384::S1 e0 + SHA384::Ch e0 f0 g0 + wk0 + h0
  y0 = SHA384::S0 a0 + SHA384::Maj a0 b0 c0
