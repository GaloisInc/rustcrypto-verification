module Utils::StringUtils where

parseInt : {l} (fin l, l >= 1) => String l -> Option [width (10^^l - 1)]
parseInt str = if isIntString str then Some (parseInt' str) else None

isIntString : {l} (fin l) => String l -> Bit
isIntString = all (\c -> (c >= '0') && (c <= '9'))

uncheckedParseInt : {l} (fin l, l >= 1) => String l -> [width (10^^l - 1)]
uncheckedParseInt = parseInt'

private

  parseInt' : {l, w} (fin l, fin w, w >= 4) => String l -> [w]
  parseInt' str
    | l == 0 => 0
    | l > 0 => parseInt' s * 10 + zext (drop`{back=4} (c - '0'))
      where s # [c] = str
