let aes128_key_schedule_spec = do {
    key <- mir_fresh_var "key" (mir_array 16 mir_u8);
    key_ref <- mir_ref_of (mir_term key);
    mir_execute_func [key_ref];
    mir_return (mir_term {{ aes128_key_schedule key }});
};

aes128_key_schedule_ov <- my_verify m "aes::soft::fixslice::aes128_key_schedule"
    (concat sub_bytes_key_ovs
        (concat inv_shift_rows_1_key_ovs
            (concat inv_shift_rows_2_key_ovs
                (concat inv_shift_rows_3_key_ovs
                    (concat sub_bytes_nots_key_ovs [bitslice_key_schedule_ov])))))
    false aes128_key_schedule_spec
    do {
        unint_z3 ["SBox"];
    };

thm_inv_bitslice_bitslice <- prove_print rme {{ \x -> inv_bitslice (bitslice x) == x }};

thm_seqMap_composition <- prove_print
    do {
        simplify (add_prelude_eqs ["map_map"] (cryptol_ss ()));
        goal_normalize ["vecEq", "Prelude::map"];
        goal_exact (parse_core
            "\\(f g : Vec 16 (Vec 8 Bool) -> Vec 16 (Vec 8 Bool)) (blocks : Vec 4 (Vec 16 (Vec 8 Bool))) -> vecEq_refl 4 (Vec 16 (Vec 8 Bool)) (vecEq 16 (Vec 8 Bool) (bvEq 8)) (vecEq_refl 16 (Vec 8 Bool) (bvEq 8) (bvEq_refl 8)) (Prelude::map (Vec 16 (Vec 8 Bool)) (Vec 16 (Vec 8 Bool)) (\\(x : Vec 16 (Vec 8 Bool)) -> f (g x)) 4 blocks)"
        );
    }
    {{
        \(f : [16][8] -> [16][8]) (g : [16][8] -> [16][8]) (blocks : [4][16][8]) ->
            [f x | x <- [g x | x <- blocks]] == [f (g x) | x <- blocks]
    }};

thm_split_join <- prove_print z3 {{
    \(block : [4][4][8]) -> split (join block) == block
}};

thm_transpose_transpose <- prove_print z3 {{
    \(block : [4][4][8]) -> transpose (transpose block) == block
}};

thm_stateTransformation_composition <- prove_print
    do {
        unfolding ["stateTransformation"];
        beta_reduce_goal;
        simplify (addsimps [thm_seqMap_composition, thm_split_join, thm_transpose_transpose] empty_ss);
        goal_exact (parse_core
            "\\(f g : Vec 4 (Vec 4 (Vec 8 Bool)) -> Vec 4 (Vec 4 (Vec 8 Bool))) (blocks : Vec 4 (Vec 16 (Vec 8 Bool))) -> vecEq_refl 4 (Vec 16 (Vec 8 Bool)) (vecEq 16 (Vec 8 Bool) (bvEq 8)) (vecEq_refl 16 (Vec 8 Bool) (bvEq 8) (bvEq_refl 8)) (Prelude::map (Vec 16 (Vec 8 Bool)) (Vec 16 (Vec 8 Bool)) (\\(x : Vec 16 (Vec 8 Bool)) -> ecJoin (TCNum 4) (TCNum 4) (Vec 8 Bool) (ecTranspose (TCNum 4) (TCNum 4) (Vec 8 Bool) (f (g (ecTranspose (TCNum 4) (TCNum 4) (Vec 8 Bool) (ecSplit (TCNum 4) (TCNum 4) (Vec 8 Bool) x)))))) 4 blocks)"
        );
    }
    {{
        \(f : AES128::State -> AES128::State) (g : AES128::State -> AES128::State) (blocks : [4][16][8]) ->
            stateTransformation f (stateTransformation g blocks) == stateTransformation (\x -> f (g x)) blocks
    }};

thms_MixColumnsN_SubBytesNots <-
    for [{{AES128::MixColumns}}, {{MixColumns1}}, {{MixColumns2}}, {{MixColumns3}}] (\mixColumns -> do {
        prove_print z3 {{
            \(state : AES128::State) ->
                mixColumns (SubBytesNots state) == SubBytesNots (mixColumns state)
        }};
    });

thm_stateTransformation_decomposition0 <- prove_print
    do {
        simplify (addsimp thm_stateTransformation_composition empty_ss);
        unint_z3 ["SubBytesNots", "MixColumns", "SubBytes"];
    }
    {{
        \(blocks : [4][16][8]) ->
            stateTransformation (\state -> SubBytesNots (AES128::MixColumns (AES128::SubBytes state))) blocks
            == stateTransformation SubBytesNots
                (stateTransformation (\state -> AES128::MixColumns (AES128::SubBytes state)) blocks)
    }};

thm_stateTransformation_decomposition1 <- prove_print
    do {
        simplify (addsimp thm_stateTransformation_composition empty_ss);
        unint_z3 ["SubBytesNots", "MixColumns", "SubBytes", "ShiftRows", "InvShiftRows"];
    }
    {{
        \(blocks : [4][16][8]) ->
            stateTransformation (\state -> SubBytesNots (MixColumns1 (AES128::SubBytes state))) blocks
            == stateTransformation (\state -> SubBytesNots (AES128::InvShiftRows state))
                (stateTransformation (\state -> AES128::MixColumns (AES128::ShiftRows (AES128::SubBytes state))) blocks)
    }};

thm_stateTransformation_decomposition2 <- prove_print
    do {
        simplify (addsimp thm_stateTransformation_composition empty_ss);
        unint_z3 ["SubBytesNots", "MixColumns", "SubBytes", "ShiftRows", "InvShiftRows"];
    }
    {{
        \(blocks : [4][16][8]) ->
            stateTransformation (\state -> SubBytesNots (MixColumns2 (AES128::SubBytes state))) blocks
            == stateTransformation (\state -> SubBytesNots (AES128::ShiftRows (AES128::ShiftRows state)))
                (stateTransformation (\state -> AES128::MixColumns (AES128::ShiftRows (AES128::ShiftRows (AES128::SubBytes state)))) blocks)
    }};

thm_stateTransformation_decomposition3 <- prove_print
    do {
        simplify (addsimp thm_stateTransformation_composition empty_ss);
        unint_z3 ["SubBytesNots", "MixColumns", "SubBytes", "ShiftRows", "InvShiftRows"];
    }
    {{
        \(blocks : [4][16][8]) ->
            stateTransformation (\state -> SubBytesNots (MixColumns3 (AES128::SubBytes state))) blocks
            == stateTransformation (\state -> SubBytesNots (AES128::ShiftRows state))
                (stateTransformation (\state -> AES128::MixColumns (AES128::InvShiftRows (AES128::SubBytes state))) blocks)
    }};

thm_stateTransformation_decomposition4 <- prove_print
    do {
        simplify (addsimp thm_stateTransformation_composition empty_ss);
        unint_z3 ["SubBytesNots", "MixColumns", "SubBytes", "ShiftRows", "InvShiftRows"];
    }
    {{
        \(blocks : [4][16][8]) ->
            stateTransformation (\state -> SubBytesNots (AES128::SubBytes (AES128::ShiftRows (AES128::ShiftRows state)))) blocks
            == stateTransformation SubBytesNots
                (stateTransformation (\state -> AES128::SubBytes (AES128::ShiftRows (AES128::ShiftRows state))) blocks)
    }};

thm_foo <- prove_print
    do {
        unint_z3 ["keyExpansion"];
    }
    {{
        \(key : [16][8]) (blocks : [4][16][8]) ->
            addRoundKey' (inv_bitslice (take`{8} (drop`{0} (aes128_key_schedule key)))) blocks
            == stateTransformation (AES128::AddRoundKey (AES128::keyExpansion (join key) @ 0)) blocks
    }};

thms_foo0 <-
    for [4, 8, 10] (\i -> do {
        prove_print
            do {
                unint_z3 ["keyExpansion"];
            }
            {{
                \(key : [16][8]) (blocks : [4][16][8]) ->
                    addRoundKey' (inv_bitslice (take`{8} (drop`{i * 8} (aes128_key_schedule key))))
                        (stateTransformation SubBytesNots blocks)
                    == stateTransformation (AES128::AddRoundKey (AES128::keyExpansion (join key) @ `i)) blocks
            }};
    });

thms_foo1 <-
    for [1, 5, 9] (\i -> do {
        prove_print
            do {
                unint_z3 ["keyExpansion"];
            }
            {{
                \(key : [16][8]) (blocks : [4][16][8]) ->
                    addRoundKey' (inv_bitslice (take`{8} (drop`{i * 8} (aes128_key_schedule key))))
                        (stateTransformation (\x -> SubBytesNots (AES128::InvShiftRows x)) blocks)
                    == stateTransformation (\x -> AES128::InvShiftRows (AES128::AddRoundKey (AES128::keyExpansion (join key) @ `i) x)) blocks
            }};
    });

thms_foo2 <-
    for [2, 6] (\i -> do {
        prove_print
            do {
                unint_z3 ["keyExpansion"];
            }
            {{
                \(key : [16][8]) (blocks : [4][16][8]) ->
                    addRoundKey' (inv_bitslice (take`{8} (drop`{i * 8} (aes128_key_schedule key))))
                        (stateTransformation (\x -> SubBytesNots (AES128::ShiftRows (AES128::ShiftRows x))) blocks)
                    == stateTransformation (\x -> AES128::ShiftRows (AES128::ShiftRows (AES128::AddRoundKey (AES128::keyExpansion (join key) @ `i) x))) blocks
            }};
    });

thms_foo3 <-
    for [3, 7] (\i -> do {
        prove_print
            do {
                unint_z3 ["keyExpansion"];
            }
            {{
                \(key : [16][8]) (blocks : [4][16][8]) ->
                    addRoundKey' (inv_bitslice (take`{8} (drop`{i * 8} (aes128_key_schedule key))))
                        (stateTransformation (\x -> SubBytesNots (AES128::ShiftRows x)) blocks)
                    == stateTransformation (\x -> AES128::ShiftRows (AES128::AddRoundKey (AES128::keyExpansion (join key) @ `i) x)) blocks
            }};
    });

thm_SubBytes_InvShiftRows <- prove_print z3 {{
    \(s : AES128::State) -> AES128::SubBytes (AES128::InvShiftRows s) == AES128::InvShiftRows (AES128::SubBytes s)
}};

thm_SubBytes_ShiftRows <- prove_print z3 {{
    \(s : AES128::State) -> AES128::SubBytes (AES128::ShiftRows s) == AES128::ShiftRows (AES128::SubBytes s)
}};

thm_ShiftRows_InvShiftRows <- prove_print z3 {{
    \(s : AES128::State) -> AES128::ShiftRows (AES128::InvShiftRows s) == s
}};

thm_InvShiftRows_ShiftRows <- prove_print z3 {{ AES128::shiftRowsInverts }};

let encrypt128_spec = do {
    key <- mir_fresh_var "key" (mir_array 16 mir_u8);
    block <- mir_fresh_var "block" (mir_array 16 mir_u8);
    mir_execute_func [mir_term key, mir_term block];
    mir_return (mir_term {{ encrypt128 key block }});
};

mir_verify m "aes_verif::encrypt128"
    (concat
        add_round_key_ovs
        [
            aes128_key_schedule_ov,
            bitslice_encrypt_ov,
            inv_bitslice_ov,
            sub_bytes_ov,
            mix_columns_0_ov,
            mix_columns_1_ov,
            mix_columns_2_ov,
            mix_columns_3_ov,
            shift_rows_2_ov
        ])
    false encrypt128_spec
    do {
        simplify (add_prelude_eqs ["implies_True1"] empty_ss);

        unfolding ["add_round_key", "sub_bytes", "mix_columns_0", "mix_columns_1", "mix_columns_2", "mix_columns_3", "shift_rows_2", "bitsliced"];

        // proof_subshell ();
        beta_reduce_goal;
        // proof_subshell ();

        simplify (addsimps [thm_inv_bitslice_bitslice, thm_stateTransformation_composition] empty_ss);

        simplify (addsimps thms_MixColumnsN_SubBytesNots empty_ss);
        simplify (addsimps [thm_stateTransformation_decomposition0, thm_stateTransformation_decomposition1, thm_stateTransformation_decomposition2, thm_stateTransformation_decomposition3, thm_stateTransformation_decomposition4] empty_ss);

        simplify
            (addsimp thm_foo
                (addsimps thms_foo0
                    (addsimps thms_foo1
                        (addsimps thms_foo2
                            (addsimps thms_foo3 empty_ss)))));

        simplify (addsimp thm_stateTransformation_composition empty_ss);

        simplify (addsimps [thm_SubBytes_ShiftRows, thm_SubBytes_InvShiftRows, thm_ShiftRows_InvShiftRows, thm_InvShiftRows_ShiftRows] empty_ss);

        unint_z3 ["AddRoundKey", "SubBytes", "ShiftRows", "MixColumns"];

        proof_subshell ();
    };

thms_SubBytesNots_InvMixColumnsN <-
    for [{{AES128::InvMixColumns}}, {{InvMixColumns1}}, {{InvMixColumns2}}, {{InvMixColumns3}}] (\invMixColumns -> do {
        prove_print z3 {{
            \(state : AES128::State) ->
                SubBytesNots (invMixColumns state) == invMixColumns (SubBytesNots state)
        }};
    });

thms_bar0 <-
    for [10, 8, 4] (\i -> do {
        prove_print
            do {
                unint_z3 ["keyExpansion"];
            }
            {{
                \(key : [16][8]) (blocks : [4][16][8]) ->
                    addRoundKey' (inv_bitslice (take`{8} (drop`{i * 8} (aes128_key_schedule key)))) blocks
                    == stateTransformation (\x -> SubBytesNots (AES128::AddRoundKey (AES128::keyExpansion (join key) @ `i) x)) blocks
            }};
    });

thms_bar1 <-
    for [9, 5, 1] (\i -> do {
        prove_print
            do {
                unint_z3 ["keyExpansion"];
            }
            {{
                \(key : [16][8]) (blocks : [4][16][8]) ->
                    addRoundKey' (inv_bitslice (take`{8} (drop`{i * 8} (aes128_key_schedule key)))) blocks
                    == stateTransformation (\x -> SubBytesNots (AES128::InvShiftRows (AES128::AddRoundKey (AES128::keyExpansion (join key) @ `i) (AES128::ShiftRows x)))) blocks
            }};
    });

thms_bar2 <-
    for [6, 2] (\i -> do {
        prove_print
            do {
                unint_z3 ["keyExpansion"];
            }
            {{
                \(key : [16][8]) (blocks : [4][16][8]) ->
                    addRoundKey' (inv_bitslice (take`{8} (drop`{i * 8} (aes128_key_schedule key)))) blocks
                    == stateTransformation (\x -> SubBytesNots (AES128::ShiftRows (AES128::ShiftRows (AES128::AddRoundKey (AES128::keyExpansion (join key) @ `i) (AES128::InvShiftRows (AES128::InvShiftRows x)))))) blocks
            }};
    });

thms_bar3 <-
    for [7, 3] (\i -> do {
        prove_print
            do {
                unint_z3 ["keyExpansion"];
            }
            {{
                \(key : [16][8]) (blocks : [4][16][8]) ->
                    addRoundKey' (inv_bitslice (take`{8} (drop`{i * 8} (aes128_key_schedule key)))) blocks
                    == stateTransformation (\x -> SubBytesNots (AES128::ShiftRows (AES128::AddRoundKey (AES128::keyExpansion (join key) @ `i) (AES128::InvShiftRows x)))) blocks
            }};
    });

thm_SubBytesNots_SubBytesNots <-
    prove_print z3 {{
        \(state : AES128::State) ->
            SubBytesNots (SubBytesNots state) == state
    }};

thm_ShiftRows_ShiftRows_ShiftRows <-
    prove_print z3 {{
        \(state : AES128::State) ->
            AES128::ShiftRows (AES128::ShiftRows (AES128::ShiftRows state)) == AES128::InvShiftRows state
    }};

thm_InvShiftRows_InvSubBytes <-
    prove_print z3 {{
        \(state : AES128::State) ->
            AES128::InvShiftRows (AES128::InvSubBytes state) == AES128::InvSubBytes (AES128::InvShiftRows state)
    }};

thm_ShiftRows_InvSubBytes <-
    prove_print z3 {{
        \(state : AES128::State) ->
            AES128::ShiftRows (AES128::InvSubBytes state) == AES128::InvSubBytes (AES128::ShiftRows state)
    }};

let decrypt128_spec = do {
    key <- mir_fresh_var "key" (mir_array 16 mir_u8);
    block <- mir_fresh_var "block" (mir_array 16 mir_u8);
    mir_execute_func [mir_term key, mir_term block];
    mir_return (mir_term {{ decrypt128 key block }});
};

mir_verify m "aes_verif::decrypt128"
    (concat
        add_round_key_ovs
        [
            aes128_key_schedule_ov,
            bitslice_encrypt_ov,
            inv_bitslice_ov,
            inv_sub_bytes_ov,
            inv_mix_columns_0_ov,
            inv_mix_columns_1_ov,
            inv_mix_columns_2_ov,
            inv_mix_columns_3_ov,
            shift_rows_2_ov
        ])
    false decrypt128_spec
    do {
        simplify (add_prelude_eqs ["implies_True1"] empty_ss);

        unfolding ["add_round_key", "inv_sub_bytes", "inv_mix_columns_0", "inv_mix_columns_1", "inv_mix_columns_2", "inv_mix_columns_3", "shift_rows_2", "bitsliced"];
        beta_reduce_goal;

        simplify
            (addsimp thm_foo
                (addsimps thms_bar0
                    (addsimps thms_bar1
                        (addsimps thms_bar2
                            (addsimps thms_bar3 empty_ss)))));

        simplify (addsimps [thm_inv_bitslice_bitslice, thm_stateTransformation_composition] empty_ss);

        simplify (addsimps thms_SubBytesNots_InvMixColumnsN empty_ss);

        simplify (addsimp thm_SubBytesNots_SubBytesNots empty_ss);

        unfolding ["InvMixColumns1", "InvMixColumns2", "InvMixColumns3"];
        beta_reduce_goal;

        simplify (addsimps [thm_ShiftRows_InvShiftRows, thm_InvShiftRows_ShiftRows, thm_ShiftRows_ShiftRows_ShiftRows, thm_InvShiftRows_InvSubBytes, thm_ShiftRows_InvSubBytes] empty_ss);

        unint_z3 ["AddRoundKey", "InvSubBytes", "InvShiftRows", "InvMixColumns"];

        proof_subshell ();
    };
