enable_experimental;

import "AesVerif/Bitslice.cry";
import "AesVerif/ProofUtils.cry";

Aes128 <- cryptol_load "AesVerif/Aes128.cry";
KeySchedule128 <- cryptol_load "AesVerif/KeySchedule128.cry";

Aes192 <- cryptol_load "AesVerif/Aes192.cry";
KeySchedule192 <- cryptol_load "AesVerif/KeySchedule192.cry";

Aes256 <- cryptol_load "AesVerif/Aes256.cry";
KeySchedule256 <- cryptol_load "AesVerif/KeySchedule256.cry";

let my_verify m f ovs ps spec tac =
    // mir_verify m f ovs ps spec tac
    mir_unsafe_assume_spec m f spec
    ;

m <- mir_load_module
    "target/aarch64-apple-darwin/debug/deps/aes_verif-a7726c0105e8b76e.linked-mir.json";

let UInt = mir_find_adt m "typenum::uint::UInt";
let UTerm = mir_find_adt m "typenum::uint::UTerm" [];
let B1 = mir_find_adt m "typenum::bit::B1" [];
let B0 = mir_find_adt m "typenum::bit::B0" [];
let U4 = UInt [
    mir_adt (UInt [
        mir_adt (UInt [
            mir_adt UTerm,
            mir_adt B1
        ]),
        mir_adt B0
    ]),
    mir_adt B0
];
let U16 = UInt [
    mir_adt (UInt [
        mir_adt U4,
        mir_adt B0
    ]),
    mir_adt B0
];
let GenericArray = mir_find_adt m "generic_array::GenericArray";
let Block = GenericArray [mir_u8, mir_adt U16];
let BatchBlocks = GenericArray [mir_adt Block, mir_adt U4];

let bitslice_cipher_spec = do {
    output_init <- mir_fresh_cryptol_var "output_init" {| FSState |};
    output_ref <- mir_ref_of_mut (mir_term output_init);
    block0 <- mir_fresh_cryptol_var "block0" {| BlockBytes |};
    block1 <- mir_fresh_cryptol_var "block1" {| BlockBytes |};
    block2 <- mir_fresh_cryptol_var "block2" {| BlockBytes |};
    block3 <- mir_fresh_cryptol_var "block3" {| BlockBytes |};
    blocks_ref <- mir_ref_of (mir_array_value (mir_adt Block) [
        mir_struct_value Block [mir_term block0],
        mir_struct_value Block [mir_term block1],
        mir_struct_value Block [mir_term block2],
        mir_struct_value Block [mir_term block3]
    ]);
    mir_execute_func [
        mir_slice_value output_ref,
        mir_slice_value (mir_field_ref (mir_elem_ref blocks_ref 0) "data"),
        mir_slice_value (mir_field_ref (mir_elem_ref blocks_ref 1) "data"),
        mir_slice_value (mir_field_ref (mir_elem_ref blocks_ref 2) "data"),
        mir_slice_value (mir_field_ref (mir_elem_ref blocks_ref 3) "data")
    ];
    mir_points_to output_ref (mir_term {{
        bitslice [block0, block1, block2, block3]
    }});
};

bitslice_cipher_ov <-
    my_verify m "aes::soft::fixslice::bitslice" [] false
        bitslice_cipher_spec rme;

let inv_bitslice_spec = do {
    input <- mir_fresh_cryptol_var "input" {| FSState |};
    input_ref <- mir_ref_of (mir_term input);
    mir_execute_func [mir_slice_value input_ref];
    let output = {{ inv_bitslice input }};
    mir_return (mir_struct_value BatchBlocks [
        mir_array_value (mir_adt Block) [
            mir_struct_value Block [mir_term {{ output @ 0 }}],
            mir_struct_value Block [mir_term {{ output @ 1 }}],
            mir_struct_value Block [mir_term {{ output @ 2 }}],
            mir_struct_value Block [mir_term {{ output @ 3 }}]
        ]
    ]);
};

inv_bitslice_ov <-
    my_verify m "aes::soft::fixslice::inv_bitslice" [] false
        inv_bitslice_spec rme;

thm_inv_bitslice_bitslice <-
    prove_print rme {{ \x -> inv_bitslice (bitslice x) == x }};

thm_seqMap_composition <- prove_print
    do {
        simplify (add_prelude_eqs ["map_map"] (cryptol_ss ()));
        goal_normalize ["vecEq", "Prelude::map"];
        goal_exact (parse_core
            "\\(f g : Vec 16 (Vec 8 Bool) -> Vec 16 (Vec 8 Bool)) (blocks : Vec 4 (Vec 16 (Vec 8 Bool))) -> vecEq_refl 4 (Vec 16 (Vec 8 Bool)) (vecEq 16 (Vec 8 Bool) (bvEq 8)) (vecEq_refl 16 (Vec 8 Bool) (bvEq 8) (bvEq_refl 8)) (Prelude::map (Vec 16 (Vec 8 Bool)) (Vec 16 (Vec 8 Bool)) (\\(x : Vec 16 (Vec 8 Bool)) -> f (g x)) 4 blocks)"
        );
    }
    {{
        \(f : BlockBytes -> BlockBytes) (g : BlockBytes -> BlockBytes) (blocks : BatchBlockBytes) ->
            [f y | y <- [g x | x <- blocks]] == [f (g x) | x <- blocks]
    }};

let eval_list_int cry_seq = do {
    for (eval_list cry_seq) (\n -> do {
        return (eval_int n);
    });
};

let mutate_state_ref_spec cry_fun = do {
    state_init <- mir_fresh_cryptol_var "state_init" {| FSState |};
    state_ref <- mir_ref_of_mut (mir_term state_init);
    mir_execute_func [state_ref];
    mir_points_to state_ref (mir_term {{ cry_fun state_init }});
};

let mutate_state_slice_spec cry_fun = do {
    state_init <- mir_fresh_cryptol_var "state_init" {| FSState |};
    state_ref <- mir_ref_of_mut (mir_term state_init);
    mir_execute_func [mir_slice_value state_ref];
    mir_points_to state_ref (mir_term {{ cry_fun state_init }});
};

let verify_aes_size
        (Aes : CryptolModule)
        (KeySchedule : CryptolModule)
        (bitslice_key_schedule_ovs : [MIRSpec])
        (key_schedule_proof : ProofScript ())
= do {

    let key_size_str = show {| Aes::Spec::KeySize |};

    rcons <- eval_list_int {{ [0..Aes::Spec::Nr] : [_][64] }};

    sub_bytes_cipher_ov <-
        my_verify m "aes::soft::fixslice::sub_bytes" [] false
            (mutate_state_slice_spec {{ Aes::sub_bytes }}) rme;

    sub_bytes_nots_cipher_ov <-
        my_verify m "aes::soft::fixslice::sub_bytes_nots" [] false
            (mutate_state_slice_spec {{ Aes::sub_bytes_nots }}) rme;

    shift_rows_2_ov <-
        my_verify m "aes::soft::fixslice::shift_rows_2" [] false
            (mutate_state_slice_spec {{ Aes::shift_rows_2 }}) rme;

    let mutate_rkeys_slice_spec rcon cry_fun = do {
        rkeys_init <- mir_fresh_cryptol_var "rkeys_init" {| Aes::FSRoundKeys |};
        rkeys_ref <- mir_ref_of_mut (mir_term rkeys_init);
        mir_execute_func [
            mir_slice_range_value rkeys_ref
                (eval_size {| rcon * 8 |})
                (eval_size {| (rcon + 1) * 8 |})
        ];
        mir_points_to rkeys_ref (mir_term {{
            modifyRound`{rcon} cry_fun rkeys_init
        }});
    };

    let verify_mutate_rkeys_slice rust_fun cry_fun = do {
        for rcons (\rcon -> do {
            my_verify m rust_fun [] false (mutate_rkeys_slice_spec rcon cry_fun) rme;
        });
    };

    // Technically only needed for AES-128 and 256
    sub_bytes_key_ovs <-
        verify_mutate_rkeys_slice
            "aes::soft::fixslice::sub_bytes" {{ Aes::sub_bytes }};

    sub_bytes_nots_key_ovs <-
        verify_mutate_rkeys_slice
            "aes::soft::fixslice::sub_bytes_nots" {{ Aes::sub_bytes_nots }};

    inv_shift_rows_1_key_ovs <-
        verify_mutate_rkeys_slice
            "aes::soft::fixslice::inv_shift_rows_1" {{ Aes::inv_shift_rows_1 }};

    inv_shift_rows_2_key_ovs <-
        verify_mutate_rkeys_slice
            "aes::soft::fixslice::inv_shift_rows_2" {{ Aes::inv_shift_rows_2 }};

    inv_shift_rows_3_key_ovs <-
        verify_mutate_rkeys_slice
            "aes::soft::fixslice::inv_shift_rows_3" {{ Aes::inv_shift_rows_3 }};

    let key_schedule_spec = do {
        key <- mir_fresh_cryptol_var "key" {| Aes::KeyBytes |};
        key_ref <- mir_ref_of (mir_term key);
        mir_execute_func [key_ref];
        mir_return (mir_term {{ KeySchedule::key_schedule key }});
    };

    let key_schedule_rust_fun = str_concats
        ["aes::soft::fixslice::aes", key_size_str, "_key_schedule"];
    key_schedule_ov <- my_verify m
        key_schedule_rust_fun
        (concat bitslice_key_schedule_ovs
            (concat sub_bytes_key_ovs
                (concat inv_shift_rows_1_key_ovs
                    (concat inv_shift_rows_2_key_ovs
                        (concat inv_shift_rows_3_key_ovs
                            (concat sub_bytes_nots_key_ovs
                                [sub_bytes_cipher_ov, sub_bytes_nots_cipher_ov]))))))
        false key_schedule_spec key_schedule_proof;

    let add_round_key_spec rk_off = do {
        state_init <- mir_fresh_cryptol_var "state_init" {| FSState |};
        state_ref <- mir_ref_of_mut (mir_term state_init);
        rkeys <- mir_fresh_cryptol_var "rkeys" {| Aes::FSRoundKeys |};
        rkeys_ref <- mir_ref_of (mir_term rkeys);
        mir_execute_func [
            state_ref,
            mir_slice_range_value rkeys_ref
                (eval_size {| rk_off * 8 |})
                (eval_size {| (rk_off + 1) * 8 |})
        ];
        mir_points_to state_ref (mir_term {{
            Aes::add_round_key state_init (sliceRound`{rk_off} rkeys)
        }});
    };

    add_round_key_ovs <-
        for rcons (\rk_off -> do {
            my_verify m "aes::soft::fixslice::add_round_key" [] false
                (add_round_key_spec rk_off) rme;
        });

    mix_columns_ovs <-
        for [
            ("mix_columns_0", {{ Aes::mix_columns_0 }}),
            ("mix_columns_1", {{ Aes::mix_columns_1 }}),
            ("mix_columns_2", {{ Aes::mix_columns_2 }}),
            ("mix_columns_3", {{ Aes::mix_columns_3 }})
        ]
        (\(rust_fun, cry_fun) -> do {
            my_verify m (str_concat "aes::soft::fixslice::" rust_fun) [] false
                (mutate_state_ref_spec cry_fun) rme;
        });

    thm_split_join <- prove_print z3 {{
        \(block : Aes::Spec::State) -> split (join block) == block
    }};

    thm_transpose_transpose <- prove_print z3 {{
        \(block : Aes::Spec::State) -> transpose (transpose block) == block
    }};

    thm_stateTransformation_composition <- prove_print
    do {
        unfolding ["stateTransformation"];
        beta_reduce_goal;
        simplify (addsimps [thm_seqMap_composition, thm_split_join, thm_transpose_transpose] empty_ss);
        goal_exact (parse_core
            "\\(f g : Vec 4 (Vec 4 (Vec 8 Bool)) -> Vec 4 (Vec 4 (Vec 8 Bool))) (blocks : Vec 4 (Vec 16 (Vec 8 Bool))) -> vecEq_refl 4 (Vec 16 (Vec 8 Bool)) (vecEq 16 (Vec 8 Bool) (bvEq 8)) (vecEq_refl 16 (Vec 8 Bool) (bvEq 8) (bvEq_refl 8)) (Prelude::map (Vec 16 (Vec 8 Bool)) (Vec 16 (Vec 8 Bool)) (\\(x : Vec 16 (Vec 8 Bool)) -> ecJoin (TCNum 4) (TCNum 4) (Vec 8 Bool) (ecTranspose (TCNum 4) (TCNum 4) (Vec 8 Bool) (f (g (ecTranspose (TCNum 4) (TCNum 4) (Vec 8 Bool) (ecSplit (TCNum 4) (TCNum 4) (Vec 8 Bool) x)))))) 4 blocks)"
        );
    }
    {{
        \(f : Aes::Spec::State -> Aes::Spec::State) (g : Aes::Spec::State -> Aes::Spec::State) (blocks : BatchBlockBytes) ->
            Aes::stateTransformation f (Aes::stateTransformation g blocks) == Aes::stateTransformation (\x -> f (g x)) blocks
    }};

    thms_MixColumnsN_SubBytesNots <-
        for [{{Aes::Spec::MixColumns}}, {{Aes::MixColumns1}}, {{Aes::MixColumns2}}, {{Aes::MixColumns3}}] (\mixColumns -> do {
            prove_print z3 {{
                \(state : Aes::Spec::State) ->
                    mixColumns (Aes::SubBytesNots state) == Aes::SubBytesNots (mixColumns state)
            }};
        });

    thm_stateTransformation_decomposition0 <- prove_print
        do {
            simplify (addsimp thm_stateTransformation_composition empty_ss);
            unint_z3 ["SubBytesNots", "MixColumns", "SubBytes"];
        }
        {{
            \(blocks : BatchBlockBytes) ->
                Aes::stateTransformation (\state -> Aes::SubBytesNots (Aes::Spec::MixColumns (Aes::Spec::SubBytes state))) blocks
                == Aes::stateTransformation Aes::SubBytesNots
                    (Aes::stateTransformation (\state -> Aes::Spec::MixColumns (Aes::Spec::SubBytes state)) blocks)
        }};

    thm_stateTransformation_decomposition1 <- prove_print
        do {
            simplify (addsimp thm_stateTransformation_composition empty_ss);
            unint_z3 ["SubBytesNots", "MixColumns", "SubBytes", "ShiftRows", "InvShiftRows"];
        }
        {{
            \(blocks : BatchBlockBytes) ->
                Aes::stateTransformation (\state -> Aes::SubBytesNots (Aes::MixColumns1 (Aes::Spec::SubBytes state))) blocks
                == Aes::stateTransformation (\state -> Aes::SubBytesNots (Aes::Spec::InvShiftRows state))
                    (Aes::stateTransformation (\state -> Aes::Spec::MixColumns (Aes::Spec::ShiftRows (Aes::Spec::SubBytes state))) blocks)
        }};

    thm_stateTransformation_decomposition2 <- prove_print
        do {
            simplify (addsimp thm_stateTransformation_composition empty_ss);
            unint_z3 ["SubBytesNots", "MixColumns", "SubBytes", "ShiftRows", "InvShiftRows"];
        }
        {{
            \(blocks : BatchBlockBytes) ->
                Aes::stateTransformation (\state -> Aes::SubBytesNots (Aes::MixColumns2 (Aes::Spec::SubBytes state))) blocks
                == Aes::stateTransformation (\state -> Aes::SubBytesNots (Aes::Spec::ShiftRows (Aes::Spec::ShiftRows state)))
                    (Aes::stateTransformation (\state -> Aes::Spec::MixColumns (Aes::Spec::ShiftRows (Aes::Spec::ShiftRows (Aes::Spec::SubBytes state)))) blocks)
        }};

    thm_stateTransformation_decomposition3 <- prove_print
        do {
            simplify (addsimp thm_stateTransformation_composition empty_ss);
            unint_z3 ["SubBytesNots", "MixColumns", "SubBytes", "ShiftRows", "InvShiftRows"];
        }
        {{
            \(blocks : BatchBlockBytes) ->
                Aes::stateTransformation (\state -> Aes::SubBytesNots (Aes::MixColumns3 (Aes::Spec::SubBytes state))) blocks
                == Aes::stateTransformation (\state -> Aes::SubBytesNots (Aes::Spec::ShiftRows state))
                    (Aes::stateTransformation (\state -> Aes::Spec::MixColumns (Aes::Spec::InvShiftRows (Aes::Spec::SubBytes state))) blocks)
        }};

    thm_stateTransformation_decomposition4 <- prove_print
        do {
            simplify (addsimp thm_stateTransformation_composition empty_ss);
            unint_z3 ["SubBytesNots", "SubBytes", "ShiftRows", "InvShiftRows"];
        }
        {{
            \(blocks : BatchBlockBytes) ->
                Aes::stateTransformation (\state -> Aes::SubBytesNots (Aes::Spec::SubBytes (Aes::Spec::ShiftRows (Aes::Spec::ShiftRows state)))) blocks
                == Aes::stateTransformation Aes::SubBytesNots
                    (Aes::stateTransformation (\state -> Aes::Spec::SubBytes (Aes::Spec::ShiftRows (Aes::Spec::ShiftRows state))) blocks)
        }};

    thm_stateTransformation_decomposition5 <- prove_print
        do {
            simplify (addsimp thm_stateTransformation_composition empty_ss);
            unint_z3 ["SubBytesNots", "SubBytes"];
        }
        {{
            \(blocks : BatchBlockBytes) ->
                Aes::stateTransformation (\state -> Aes::SubBytesNots (Aes::Spec::SubBytes state)) blocks
                == Aes::stateTransformation Aes::SubBytesNots (Aes::stateTransformation Aes::Spec::SubBytes blocks)
        }};

    thm_foo <- prove_print
        do {
            unint_z3 ["keyExpansion"];
        }
        {{
            \(key : Aes::KeyBytes) (blocks : BatchBlockBytes) ->
                Aes::addRoundKey' (sliceRound`{0} (KeySchedule::key_schedule key)) blocks
                == Aes::stateTransformation (Aes::Spec::AddRoundKey (Aes::Spec::keyExpansion (join key) @ 0)) blocks
        }};

    foo0_rcons <- eval_list_int {{ [4 ..< Aes::Spec::Nr by 4] # [`Aes::Spec::Nr] : [_][64] }};
    thms_foo0 <-
        for foo0_rcons (\i -> do {
            prove_print
                do {
                    unint_z3 ["keyExpansion"];
                }
                {{
                    \(key : Aes::KeyBytes) (blocks : BatchBlockBytes) ->
                        Aes::addRoundKey' (sliceRound`{i} (KeySchedule::key_schedule key))
                            (Aes::stateTransformation Aes::SubBytesNots blocks)
                        == Aes::stateTransformation (Aes::Spec::AddRoundKey (Aes::Spec::keyExpansion (join key) @ `i)) blocks
                }};
        });

    foo1_rcons <- eval_list_int {{ [1 ..< Aes::Spec::Nr by 4] : [_][64] }};
    thms_foo1 <-
        for foo1_rcons (\i -> do {
            prove_print
                do {
                    unint_z3 ["keyExpansion"];
                }
                {{
                    \(key : Aes::KeyBytes) (blocks : BatchBlockBytes) ->
                        Aes::addRoundKey' (sliceRound`{i} (KeySchedule::key_schedule key))
                            (Aes::stateTransformation (\x -> Aes::SubBytesNots (Aes::Spec::InvShiftRows x)) blocks)
                        == Aes::stateTransformation (\x -> Aes::Spec::InvShiftRows (Aes::Spec::AddRoundKey (Aes::Spec::keyExpansion (join key) @ `i) x)) blocks
                }};
        });

    foo2_rcons <- eval_list_int {{ [2 ..< Aes::Spec::Nr by 4] : [_][64] }};
    thms_foo2 <-
        for foo2_rcons (\i -> do {
            prove_print
                do {
                    unint_z3 ["keyExpansion"];
                }
                {{
                    \(key : Aes::KeyBytes) (blocks : BatchBlockBytes) ->
                        Aes::addRoundKey' (sliceRound`{i} (KeySchedule::key_schedule key))
                            (Aes::stateTransformation (\x -> Aes::SubBytesNots (Aes::Spec::ShiftRows (Aes::Spec::ShiftRows x))) blocks)
                        == Aes::stateTransformation (\x -> Aes::Spec::ShiftRows (Aes::Spec::ShiftRows (Aes::Spec::AddRoundKey (Aes::Spec::keyExpansion (join key) @ `i) x))) blocks
                }};
        });

    foo3_rcons <- eval_list_int {{ [3 ..< Aes::Spec::Nr by 4] : [_][64] }};
    thms_foo3 <-
        for foo3_rcons (\i -> do {
            prove_print
                do {
                    unint_z3 ["keyExpansion"];
                }
                {{
                    \(key : Aes::KeyBytes) (blocks : BatchBlockBytes) ->
                        Aes::addRoundKey' (sliceRound`{i} (KeySchedule::key_schedule key))
                            (Aes::stateTransformation (\x -> Aes::SubBytesNots (Aes::Spec::ShiftRows x)) blocks)
                        == Aes::stateTransformation (\x -> Aes::Spec::ShiftRows (Aes::Spec::AddRoundKey (Aes::Spec::keyExpansion (join key) @ `i) x)) blocks
                }};
        });

    thm_SubBytes_InvShiftRows <- prove_print z3 {{
        \(s : Aes::Spec::State) -> Aes::Spec::SubBytes (Aes::Spec::InvShiftRows s) == Aes::Spec::InvShiftRows (Aes::Spec::SubBytes s)
    }};

    thm_SubBytes_ShiftRows <- prove_print z3 {{
        \(s : Aes::Spec::State) -> Aes::Spec::SubBytes (Aes::Spec::ShiftRows s) == Aes::Spec::ShiftRows (Aes::Spec::SubBytes s)
    }};

    thm_ShiftRows_InvShiftRows <- prove_print z3 {{
        \(s : Aes::Spec::State) -> Aes::Spec::ShiftRows (Aes::Spec::InvShiftRows s) == s
    }};

    thm_InvShiftRows_ShiftRows <- prove_print z3 {{ Aes::Spec::shiftRowsInverts }};

    let encrypt_spec = do {
        key <- mir_fresh_cryptol_var "key" {| Aes::KeyBytes |};
        block <- mir_fresh_cryptol_var "block" {| BlockBytes |};
        mir_execute_func [mir_term key, mir_term block];
        mir_return (mir_term {{ Aes::encrypt key block }});
    };

    mir_verify m (str_concat "aes_verif::encrypt" key_size_str)
        (concat add_round_key_ovs
            (concat mix_columns_ovs
                [
                    key_schedule_ov,
                    bitslice_cipher_ov,
                    inv_bitslice_ov,
                    sub_bytes_cipher_ov,
                    shift_rows_2_ov
                ]))
        false encrypt_spec
        do {
            unfolding ["add_round_key", "sub_bytes", "mix_columns_0", "mix_columns_1", "mix_columns_2", "mix_columns_3", "shift_rows_2", "bitsliced"];

            simplify
                (addsimps thms_MixColumnsN_SubBytesNots
                    (addsimps
                        [
                            thm_inv_bitslice_bitslice,
                            thm_stateTransformation_composition
                        ]
                        empty_ss));

            simplify
                (addsimps
                    [
                        thm_stateTransformation_decomposition0,
                        thm_stateTransformation_decomposition1,
                        thm_stateTransformation_decomposition2,
                        thm_stateTransformation_decomposition3,
                        thm_stateTransformation_decomposition4,
                        thm_stateTransformation_decomposition5
                    ]
                    empty_ss);

            simplify
                (addsimp thm_foo
                    (addsimps thms_foo0
                        (addsimps thms_foo1
                            (addsimps thms_foo2
                                (addsimps thms_foo3 empty_ss)))));

            simplify
                (addsimps
                    [
                        thm_stateTransformation_composition,
                        thm_SubBytes_ShiftRows,
                        thm_SubBytes_InvShiftRows,
                        thm_ShiftRows_InvShiftRows,
                        thm_InvShiftRows_ShiftRows
                    ]
                    empty_ss);

            unint_z3 ["AddRoundKey", "SubBytes", "ShiftRows", "MixColumns", "keyExpansion"];
        };

    inv_sub_bytes_ov <-
        my_verify m "aes::soft::fixslice::inv_sub_bytes" [] false
            (mutate_state_slice_spec {{ Aes::inv_sub_bytes }}) rme;

    inv_mix_columns_ovs <-
        for [
            ("inv_mix_columns_0", {{ Aes::inv_mix_columns_0 }}),
            ("inv_mix_columns_1", {{ Aes::inv_mix_columns_1 }}),
            ("inv_mix_columns_2", {{ Aes::inv_mix_columns_2 }}),
            ("inv_mix_columns_3", {{ Aes::inv_mix_columns_3 }})
        ]
        (\(rust_fun, cry_fun) -> do {
            my_verify m (str_concat "aes::soft::fixslice::" rust_fun) [] false
                (mutate_state_ref_spec cry_fun) rme;
        });

    thms_SubBytesNots_InvMixColumnsN <-
        for [{{Aes::Spec::InvMixColumns}}, {{Aes::InvMixColumns1}}, {{Aes::InvMixColumns2}}, {{Aes::InvMixColumns3}}] (\invMixColumns -> do {
            prove_print z3 {{
                \(state : Aes::Spec::State) ->
                    Aes::SubBytesNots (invMixColumns state) == invMixColumns (Aes::SubBytesNots state)
            }};
        });

    thms_bar0 <-
        for foo0_rcons (\i -> do {
            prove_print
                do {
                    unint_z3 ["keyExpansion"];
                }
                {{
                    \(key : Aes::KeyBytes) (blocks : BatchBlockBytes) ->
                        Aes::addRoundKey' (sliceRound`{i} (KeySchedule::key_schedule key)) blocks
                        == Aes::stateTransformation (\x -> Aes::SubBytesNots (Aes::Spec::AddRoundKey (Aes::Spec::keyExpansion (join key) @ `i) x)) blocks
                }};
        });

    thms_bar1 <-
        for foo1_rcons (\i -> do {
            prove_print
                do {
                    unint_z3 ["keyExpansion"];
                }
                {{
                    \(key : Aes::KeyBytes) (blocks : BatchBlockBytes) ->
                        Aes::addRoundKey' (sliceRound`{i} (KeySchedule::key_schedule key)) blocks
                        == Aes::stateTransformation (\x -> Aes::SubBytesNots (Aes::Spec::InvShiftRows (Aes::Spec::AddRoundKey (Aes::Spec::keyExpansion (join key) @ `i) (Aes::Spec::ShiftRows x)))) blocks
                }};
        });

    thms_bar2 <-
        for foo2_rcons (\i -> do {
            prove_print
                do {
                    unint_z3 ["keyExpansion"];
                }
                {{
                    \(key : Aes::KeyBytes) (blocks : BatchBlockBytes) ->
                        Aes::addRoundKey' (sliceRound`{i} (KeySchedule::key_schedule key)) blocks
                        == Aes::stateTransformation (\x -> Aes::SubBytesNots (Aes::Spec::ShiftRows (Aes::Spec::ShiftRows (Aes::Spec::AddRoundKey (Aes::Spec::keyExpansion (join key) @ `i) (Aes::Spec::InvShiftRows (Aes::Spec::InvShiftRows x)))))) blocks
                }};
        });

    thms_bar3 <-
        for foo3_rcons (\i -> do {
            prove_print
                do {
                    unint_z3 ["keyExpansion"];
                }
                {{
                    \(key : Aes::KeyBytes) (blocks : BatchBlockBytes) ->
                        Aes::addRoundKey' (sliceRound`{i} (KeySchedule::key_schedule key)) blocks
                        == Aes::stateTransformation (\x -> Aes::SubBytesNots (Aes::Spec::ShiftRows (Aes::Spec::AddRoundKey (Aes::Spec::keyExpansion (join key) @ `i) (Aes::Spec::InvShiftRows x)))) blocks
                }};
        });

    thm_SubBytesNots_SubBytesNots <-
        prove_print z3 {{
            \(state : Aes::Spec::State) ->
                Aes::SubBytesNots (Aes::SubBytesNots state) == state
        }};

    thm_ShiftRows_ShiftRows_ShiftRows <-
        prove_print z3 {{
            \(state : Aes::Spec::State) ->
                Aes::Spec::ShiftRows (Aes::Spec::ShiftRows (Aes::Spec::ShiftRows state)) == Aes::Spec::InvShiftRows state
        }};

    thm_InvShiftRows_InvSubBytes <-
        prove_print z3 {{
            \(state : Aes::Spec::State) ->
                Aes::Spec::InvShiftRows (Aes::Spec::InvSubBytes state) == Aes::Spec::InvSubBytes (Aes::Spec::InvShiftRows state)
        }};

    thm_ShiftRows_InvSubBytes <-
        prove_print z3 {{
            \(state : Aes::Spec::State) ->
                Aes::Spec::ShiftRows (Aes::Spec::InvSubBytes state) == Aes::Spec::InvSubBytes (Aes::Spec::ShiftRows state)
        }};

    let decrypt_spec = do {
        key <- mir_fresh_cryptol_var "key" {| Aes::KeyBytes |};
        block <- mir_fresh_cryptol_var "block" {| BlockBytes |};
        mir_execute_func [mir_term key, mir_term block];
        mir_return (mir_term {{ Aes::decrypt key block }});
    };

    mir_verify m (str_concat "aes_verif::decrypt" key_size_str)
        (concat add_round_key_ovs
            (concat inv_mix_columns_ovs
                [
                    key_schedule_ov,
                    bitslice_cipher_ov,
                    inv_bitslice_ov,
                    inv_sub_bytes_ov,
                    shift_rows_2_ov
                ]))
        false decrypt_spec
        do {
            unfolding ["add_round_key", "inv_sub_bytes", "inv_mix_columns_0", "inv_mix_columns_1", "inv_mix_columns_2", "inv_mix_columns_3", "shift_rows_2", "bitsliced"];

            simplify
                (addsimp thm_foo
                    (addsimps thms_bar0
                        (addsimps thms_bar1
                            (addsimps thms_bar2
                                (addsimps thms_bar3
                                    (addsimps thms_SubBytesNots_InvMixColumnsN
                                        (addsimps
                                            [
                                                thm_inv_bitslice_bitslice,
                                                thm_stateTransformation_composition,
                                                thm_SubBytesNots_SubBytesNots
                                            ]
                                            empty_ss)))))));

            unfolding ["InvMixColumns1", "InvMixColumns2", "InvMixColumns3"];

            simplify (addsimps [thm_ShiftRows_InvShiftRows, thm_InvShiftRows_ShiftRows, thm_ShiftRows_ShiftRows_ShiftRows, thm_InvShiftRows_InvSubBytes, thm_ShiftRows_InvSubBytes] empty_ss);

            unint_z3 ["AddRoundKey", "InvSubBytes", "InvShiftRows", "InvMixColumns", "keyExpansion"];
        };

};

let bitslice_key_128_spec = do {
    rkeys_init <- mir_fresh_cryptol_var "rkeys_init" {| Aes128::FSRoundKeys |};
    rkeys_ref <- mir_ref_of_mut (mir_term rkeys_init);
    key <- mir_fresh_cryptol_var "key" {| Aes128::KeyBytes |};
    key_ref <- mir_ref_of (mir_term key);
    mir_execute_func [
        mir_slice_range_value rkeys_ref 0 8,
        mir_slice_value key_ref,
        mir_slice_value key_ref,
        mir_slice_value key_ref,
        mir_slice_value key_ref
    ];
    mir_points_to rkeys_ref (mir_term {{
        bitslice [key, key, key, key] # drop`{8} rkeys_init
    }});
};

bitslice_key_128_ov <-
    my_verify m "aes::soft::fixslice::bitslice" [] false bitslice_key_128_spec rme;

// key schedule verification ~1 min
verify_aes_size Aes128 KeySchedule128 [bitslice_key_128_ov] (unint_z3 ["SBox"]);

let bitslice_key_192_front_spec = do {
    rkeys_init <- mir_fresh_cryptol_var "rkeys_init" {| Aes192::FSRoundKeys |};
    rkeys_ref <- mir_ref_of_mut (mir_term rkeys_init);
    key <- mir_fresh_cryptol_var "key" {| Aes192::KeyBytes |};
    key_ref <- mir_ref_of (mir_term key);
    mir_execute_func [
        mir_slice_range_value rkeys_ref 0 8,
        mir_slice_range_value key_ref 0 16,
        mir_slice_range_value key_ref 0 16,
        mir_slice_range_value key_ref 0 16,
        mir_slice_range_value key_ref 0 16
    ];
    mir_points_to rkeys_ref (mir_term {{
        bitslice [take key, take key, take key, take key] # drop`{8} rkeys_init
    }});
};

bitslice_key_192_front_ov <-
    my_verify m "aes::soft::fixslice::bitslice" [] false bitslice_key_192_front_spec rme;

let bitslice_key_192_back_spec = do {
    tmp_init <- mir_fresh_cryptol_var "tmp_init" {| FSState |};
    tmp_ref <- mir_ref_of_mut (mir_term tmp_init);
    key <- mir_fresh_cryptol_var "key" {| Aes192::KeyBytes |};
    key_ref <- mir_ref_of (mir_term key);
    mir_execute_func [
        mir_slice_value tmp_ref,
        mir_slice_range_value key_ref 8 24,
        mir_slice_range_value key_ref 8 24,
        mir_slice_range_value key_ref 8 24,
        mir_slice_range_value key_ref 8 24
    ];
    mir_points_to tmp_ref (mir_term {{
        bitslice [drop key, drop key, drop key, drop key]
    }});
};

bitslice_key_192_back_ov <-
    my_verify m "aes::soft::fixslice::bitslice" [] false bitslice_key_192_back_spec rme;

// key schedule verification ~5 min
verify_aes_size Aes192 KeySchedule192 [bitslice_key_192_front_ov, bitslice_key_192_back_ov] z3;

let bitslice_key_256_front_spec = do {
    rkeys_init <- mir_fresh_cryptol_var "rkeys_init" {| Aes256::FSRoundKeys |};
    rkeys_ref <- mir_ref_of_mut (mir_term rkeys_init);
    key <- mir_fresh_cryptol_var "key" {| Aes256::KeyBytes |};
    key_ref <- mir_ref_of (mir_term key);
    mir_execute_func [
        mir_slice_range_value rkeys_ref 0 8,
        mir_slice_range_value key_ref 0 16,
        mir_slice_range_value key_ref 0 16,
        mir_slice_range_value key_ref 0 16,
        mir_slice_range_value key_ref 0 16
    ];
    mir_points_to rkeys_ref (mir_term {{
        bitslice [take key, take key, take key, take key] # drop`{8} rkeys_init
    }});
};

bitslice_key_256_front_ov <-
    my_verify m "aes::soft::fixslice::bitslice" [] false bitslice_key_256_front_spec rme;

let bitslice_key_256_back_spec = do {
    rkeys_init <- mir_fresh_cryptol_var "rkeys_init" {| Aes256::FSRoundKeys |};
    rkeys_ref <- mir_ref_of_mut (mir_term rkeys_init);
    key <- mir_fresh_cryptol_var "key" {| Aes256::KeyBytes |};
    key_ref <- mir_ref_of (mir_term key);
    mir_execute_func [
        mir_slice_range_value rkeys_ref 8 16,
        mir_slice_range_value key_ref 16 32,
        mir_slice_range_value key_ref 16 32,
        mir_slice_range_value key_ref 16 32,
        mir_slice_range_value key_ref 16 32
    ];
    mir_points_to rkeys_ref (mir_term {{
        take`{8} rkeys_init # bitslice [drop key, drop key, drop key, drop key] # drop`{16} rkeys_init
    }});
};

bitslice_key_256_back_ov <-
    my_verify m "aes::soft::fixslice::bitslice" [] false bitslice_key_256_back_spec rme;

// key schedule verification ~9 min
verify_aes_size Aes256 KeySchedule256 [bitslice_key_256_front_ov, bitslice_key_256_back_ov] z3;
