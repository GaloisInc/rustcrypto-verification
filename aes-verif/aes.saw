let add_round_key_spec rk_off = do {
    state_init <- mir_fresh_var "state_init" (mir_array 8 mir_u64);
    state_ref <- mir_ref_of_mut (mir_term state_init);
    rkeys <- mir_fresh_var "rkeys" (mir_array 88 mir_u64);
    rkeys_ref <- mir_ref_of (mir_term rkeys);
    mir_execute_func [
        state_ref,
        mir_slice_range_value rkeys_ref
            (eval_size {| rk_off * 8 |})
            (eval_size {| (rk_off + 1) * 8 |})
    ];
    mir_points_to state_ref (mir_term {{
        add_round_key state_init (take`{8} (drop`{rk_off * 8} rkeys))
    }});
};

